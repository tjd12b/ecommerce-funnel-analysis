    <worksheet name='03_Traffic_Source_Revenue'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Top Revenue-Generating Traffic Sources</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='channel_performance_results' name='federated.0pebqhk04kpipi17oieaa047qmfw' />
          </datasources>
          <datasource-dependencies datasource='federated.0pebqhk04kpipi17oieaa047qmfw'>
            <column-instance column='[traffic_source]' derivation='None' name='[none:traffic_source:nk]' pivot='key' type='nominal' />
            <column-instance column='[total_revenue]' derivation='Sum' name='[sum:total_revenue:qk]' pivot='key' type='quantitative' />
            <column caption='Revenue ($)' datatype='real' name='[total_revenue]' role='measure' type='quantitative' />
            <column caption='Traffic Source' datatype='string' name='[traffic_source]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0pebqhk04kpipi17oieaa047qmfw].[none:traffic_source:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([total_revenue])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:traffic_source:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.0pebqhk04kpipi17oieaa047qmfw].[none:traffic_source:nk]' direction='DESC' using='[federated.0pebqhk04kpipi17oieaa047qmfw].[sum:total_revenue:qk]' />
          <slices>
            <column>[federated.0pebqhk04kpipi17oieaa047qmfw].[none:traffic_source:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='field-labels'>
            <format attr='font-size' value='10' />
